  "16_not_exists.sql": {
    "expected_status": "ok",
    "fields": {
      "customer_name": {
        "value": [
          "shop.main.customers.name"
        ],
        "control_contains": [
          "shop.main.orders.status",
          "shop.main.orders.customer_id"
        ],
        "existence_row_sets": [
          "row_set:shop.main.orders"
        ]
      }
    },
    "notes": "NOT EXISTS 与 EXISTS 对称：删空表使条件翻转，行集为空属于 existence；内层匹配列属于 control"
