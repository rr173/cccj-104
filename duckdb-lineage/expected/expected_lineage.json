  "10_having_derived.sql": {
    "expected_status": "ok",
    "fields": {
      "total_amount": {
        "value": [
          "shop.main.order_items.qty",
          "shop.main.order_items.unit_price"
        ],
        "control_contains": [
          "shop.main.order_items.qty",
          "shop.main.order_items.unit_price"
        ]
