  "11_named_window.sql": {
    "expected_status": "ok",
    "fields": {
      "region_seq": {
        "value_row_sets": [
          "row_set:hr.main.staff"
        ],
        "control_contains": [
          "hr.main.staff.region_id",
          "hr.main.staff.hire_date"
