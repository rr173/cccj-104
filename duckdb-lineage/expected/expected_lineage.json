  },
  "12_filtered_count.sql": {
    "expected_status": "ok",
    "fields": {
      "paid_order_count": {
        "value_row_sets": [
          "row_set:shop.main.orders"
        ],
        "control_contains": [
          "shop.main.orders.status"
        ],
        "forbidden_value_contains": [
          "shop.main.orders.status"
        ]
      }
    },
    "notes": "CTE 内部 WHERE status 决定行数，外层 COUNT(*) 不引用任何内层列时 status 仍须作为 control 上带；行集标记只承担 value"
  },
  "13_join_name_and_scalar_role.sql": {
    "expected_status": "ok",
    "fields": {
      "customer_name": {
        "value": [
          "shop.main.customers.name"
        ],
        "control_contains": [
          "shop.main.orders.status"
        ]
      },
      "max_paid_amount": {
        "value": [
          "shop.main.orders.amount"
        ],
        "control_contains": [
          "shop.main.orders.status",
          "shop.main.orders.customer_id"
        ],
        "forbidden_value_contains": [
          "shop.main.orders.status"
