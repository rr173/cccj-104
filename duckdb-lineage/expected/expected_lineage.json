  "09_filter_only_column.sql": {
    "expected_status": "ok",
    "fields": {
      "customer_name": {
        "value": [
          "shop.main.customers.name"
        ],
        "control_contains": [
          "shop.main.customers.city",
          "shop.main.customers.tier"
        ],
